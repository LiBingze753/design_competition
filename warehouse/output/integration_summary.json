      "appointment_compliance_pct": 30.3,
      "rescheduled_vehicles": 0,
      "late_vehicles": 0,
      "dock_utilisation_pct": 5.4
    },
    "integrated": {
      "vehicles": 33,
      "orders": 33,
      "average_wait_min": 0.0,
      "max_wait_min": 0.0,
      "average_cargo_wait_min": 0.0,
